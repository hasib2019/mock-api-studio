# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.env.local
# typescript
*.tsbuildinfo
next-env.d.ts

# mock api studio - runtime data
# The registered definitions in /data/projects and /data/endpoints ARE meant to
# be committed and shared with the team. Request logs are not, but the folder
# itself must stay tracked (via .gitkeep) so it exists on read-only deploys
# (e.g. Vercel) that cannot `mkdir` it at runtime.
/data/logs/*
!/data/logs/.gitkeep

# local env files (the checked-in template .env.example stays tracked)
.env*.local
!.env.example
