# ------------------------------------------------------------------
# Mock API Studio - environment
#
# Copy this file to `.env.local` and adjust. Nothing here is required for
# local development, but SESSION_SECRET must be set before you deploy.
#   cp .env.example .env.local        (PowerShell: Copy-Item .env.example .env.local)
# ------------------------------------------------------------------

# Secret used to sign the studio session cookie (HMAC-SHA256).
# Any long random string; changing it signs every user out immediately.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# If this is left unset the app falls back to a well-known development secret
# and logs a warning in production - do not ship like that.
SESSION_SECRET=change-me-to-a-long-random-string

# The first studio user. It is created on the very first run, in
# <MOCK_DATA_DIR>/users.json. Once that file exists these two values are
# ignored - change passwords from the Users page instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Where the registered projects, endpoints, users and request logs are stored.
# Defaults to ./data next to package.json. Point it at a persistent volume in
# production, or at a shared/synced folder if a whole team edits the mocks.
# MOCK_DATA_DIR=D:/ERA/mock-api-studio/data
# MOCK_DATA_DIR=/var/lib/mock-api-studio

# How many request logs are kept in data/logs/requests.json. The oldest entries
# are pruned on every write. Default: 500.
# MOCK_LOG_RETENTION=500
